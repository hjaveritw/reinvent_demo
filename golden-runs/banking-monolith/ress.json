    { "recipe": "R-BIGDECIMAL", "description": "double → BigDecimal(19,2), HALF_EVEN.", "targets": ["service/TransferService.java", "model/Account.java"] },
    { "recipe": "R-PAN-TOKEN", "description": "Card number → SHA-256 token.", "targets": ["security/CardTokenizer.java"] },
    { "recipe": "R-FIELD-ENCRYPT", "description": "SSN/owner name encrypted at rest.", "targets": ["security/EncryptedStringConverter.java"] },
    { "recipe": "R-AUDIT", "description": "Auditing listeners on Account.", "targets": ["model/Account.java"] },
    { "recipe": "R-SLF4J-MASK", "description": "Masked parameterized logging.", "targets": ["web/TransferController.java", "logging/PiiMasker.java"] },
    { "recipe": "R-PARITY-TESTS", "description": "Parity tests BR-01..BR-06.", "targets": ["src/test/**"] }
  ]
